# Process environment variables; Spring Boot does not load this file automatically.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8090
ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
SESSION_COOKIE_SECURE=false
# Default DB is a persistent H2 file. Optional MySQL 8:
# DB_URL=jdbc:mysql://127.0.0.1:3306/parking?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# DB_USER=parking_app
# DB_PASSWORD=
COZE_API_TOKEN=
COZE_BOT_ID=
COZE_WF_CHARGE=
COZE_WF_REVERSE_SEARCH=
COZE_WF_ROUTE_RECOMMEND=
# At least 32 characters; same value in backend and Coze code-node secret environment:
COZE_SERVICE_TOKEN=
# The following are configured inside Coze, not the frontend:
PARKING_API_URL=
AMAP_API_KEY=
# Legacy direct-DB nodes only:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=parking_lots
